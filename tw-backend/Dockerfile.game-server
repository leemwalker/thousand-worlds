# Build Stage
FROM golang:1.22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Build statically linked binary with size optimizations
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o game-server ./cmd/game-server/main.go

# Final Stage
FROM alpine:3.19
RUN apk add --no-cache ca-certificates wget
WORKDIR /root/
COPY --from=builder /app/game-server .
COPY --from=builder /app/migrations ./migrations
# Ensure data directories exist
RUN mkdir -p data/tech_trees data/recipes
EXPOSE 8080
CMD ["./game-server"]
